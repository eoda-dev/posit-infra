[Server]
Address = https://${FQDN}
;ServerName = ""
EmailProvider = "none"

; sudo rsync -a /var/lib/rstudio-connect/ ${CONNECT_DATA_DIR}
;DataDir = ${CONNECT_DATA_DIR}

[HTTP]
NoWarning = true
Listen = ":3939"

[HTTPS]
Listen = ":443"
Certificate = ${SSL_CERTIFICATE}
Key = ${SSL_CERTIFICATE_KEY}
MinimumTLS = 1.2

[Database]
Provider = SQlite

;Provider = postgres
;MaxIdleConnections = 5
;MaxOpenConnections = 10
;ConnectionMaxLifetime = 60s

[SQLite]

;[Postgres]
;Password = ${PGPASSWORD_ENCRYPTED}
;URL = "postgres://${PGUSER}@${PGHOST}/${PGDATABASE}"
;URL = "postgres://${PGUSER}@${PGHOST}/${PGDATABASE}?sslmode=disable"
;URL = "postgres://${PGUSER}@${PGHOST}/${PGDATABASE}?options=-csearch_path=${PG_SCHEMA_CONNECT}"
;URL = "postgres://${PGUSER}@${PGHOST}/${PGDATABASE}?sslmode=disable&options=-csearch_path=${PG_SCHEMA_CONNECT}"

;AzureTenantId = "our-tenant-id"
;AzureClientId = "example"
;AzureClientSecret = <encrypted, Base64-encoded client secret>

;Authentication]
;Provider = "oauth2"

;[OAuth2]
;ClientId = "${OAUTH_CLIENT_ID}"
;ClientSecret = "${OAUTH_CLIENT_SECRET_ENCRYPTED}"
;OpenIDConnectIssuer = "${OAUTH_ISSUER}"
;RequireUsernameClaim = true

;FirstNameClaim = "name"
;LastNameClaim = "preferred_username"

;Scopes = "openid profile email groups"
;GroupsClaim = "groups"
;GroupsAutoProvision = true

;PermittedLoginGroup = "connect-users"

;[SAML]
;IdPMetaDataURL = "https://login.microsoftonline.com/<tenant-id>/federationmetadata/2007-06/federationmetadata.xml?appid=<app-id>"
;IdPMetaDataURL = "${SAML_META_DATA_URL}"
;IdPAttributeProfile = "azure"

[RPackageRepository "CRAN"]
; echo https://packagemanager.posit.co/cran/__linux__/$(lsb_release -cs)/latest
;URL = ${R_PACKAGE_REPOSITORY}

[R]
PositPackageManagerURLRewriting = force-binary
PackageRepositoryResolution = strict
External = Matrix

[Python]
Enabled = true
Executable = /opt/python/${PYTHON_VERSION}/bin/python3

[Quarto]
Enabled = true
;Executable = /usr/local/bin/quarto
Executable = /opt/quarto/${QUARTO_VERSION}/bin/quarto

[Applications]
BundleRetentionLimit = 3

